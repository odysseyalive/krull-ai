# Krull AI Environment Configuration
# Copy this file to .env and adjust as needed.
# The start script auto-generates .env with GPU detection — these are optional overrides.

# --- Docker Compose ---
# GPU override is auto-detected by ./krull start. Set manually if needed:
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# --- Ollama ---
# Default model to pull with ./krull pull-model (no arguments)
# OLLAMA_MODEL=frob/qwen3.5-instruct:9b

# Preferred quantized artifact suffix for model pulls (optional): q4_0, q8_0, etc.
# When set, the pull step tries to fetch <model>-<suffix> first and falls back to the
# base model if the quantized artifact is unavailable.
# OLLAMA_PREFERRED_QUANT=q4_0

# Context window size (tokens). Match your model's max context.
# OLLAMA_NUM_CTX=131072

# Flash attention (1 = on). Reduces VRAM use and is required for a quantized KV cache.
# OLLAMA_FLASH_ATTENTION=1

# KV cache quantization (q8_0, q4_0, f16). q8_0 roughly halves KV-cache VRAM vs f16,
# letting a larger context window fit. Requires flash attention.
# OLLAMA_KV_CACHE_TYPE=q8_0

# Concurrent request slots per model. Each slot needs its own KV cache, so VRAM scales
# as slots x context window. 1 = serialize (allows the biggest context); higher lets
# agents run concurrently but each context must be smaller.
# OLLAMA_NUM_PARALLEL=1

# --- Model Parameters ---
# Applied when pulling models with ./krull pull-model.
# Temperature 0.8 balances creativity with coherence for voice/persona work.
# Lower (0.6-0.7) for coding, higher (0.9) for more varied prose.
# OLLAMA_TEMPERATURE=0.8
# OLLAMA_TOP_P=0.8
# OLLAMA_TOP_K=20
# OLLAMA_PRESENCE_PENALTY=1.5
# Caps tokens generated in a single response, preventing runaway generations.
# OLLAMA_NUM_PREDICT=4096

# --- Context Management ---
# Token threshold for auto-compacting conversation history.
# Should be ~75% of OLLAMA_NUM_CTX.
# CONTEXT_COMPACT_LIMIT=98304

# --- Security ---
# Open WebUI secret key (used for session tokens). Generate a real one for production.
# WEBUI_SECRET_KEY=changeme-generate-a-real-key

# LiteLLM API key (used by Claude Code to authenticate with the gateway).
# LITELLM_MASTER_KEY=sk-local-dev-key

# --- Geocoding ---
# Restrict Photon geocoding data to a specific country (ISO 3166-1 alpha-2).
# Leave empty for worldwide coverage.
# PHOTON_COUNTRY_CODE=US

# --- FAA Charts ---
# FAA VFR Sectional Chart edition date (updated every 56 days).
# Check https://aeronav.faa.gov/visual/ for the current edition.
# FAA_EDITION=03-19-2026

# --- Agents ---
# Total tool-call turns allowed in a conversation before the SSE proxy strips tools
# and forces a final answer. Guards against tool-call loops.
# KRULL_TOOL_CALL_HARD_CAP=20

# Agent worker tuning (written to the krull-claude session meta by
# scripts/krull-claude-session-meta.sh)
# AGENT_MAX_PARALLEL=3
# KRULL_AGENT_TOKEN_BUDGET=4096
# KRULL_AGENT_TIMEOUT_SECONDS=120
