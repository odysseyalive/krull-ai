#!/bin/bash
# Auto-accept tool prompts when running in --print/-p mode. In interactive
# mode Claude Code shows the user a permission prompt for every tool call
# and the user can click through, but in --print mode any unanswered prompt
# blocks the run forever. The lang_docs filter (proxy/sse_patch.py) teaches
# the model to query the offline Kiwix devdocs via `curl localhost:8090`,
# which would be silently blocked in --print mode without this. Interactive
# sessions are unaffected — the prompts still appear there.
PRINT_MODE=0
for arg in "$@"; do
  case "$arg" in
    -p|--print) PRINT_MODE=1; break ;;
  esac
done

EXTRA=()
if [ "$PRINT_MODE" -eq 1 ]; then
  EXTRA+=(--permission-mode acceptEdits)
fi

# Session ID, so proxy logs can be correlated with this invocation.
# Written to a known file the proxy reads (it has $HOME mounted read-only).
# Also exported so hooks/scripts can reference it.
#
# The ID is kept only when it was handed to this very process.
# krull-claude-session-meta.sh names its per-session metadata file after
# the ID and then execs this script, which keeps its PID, so it marks the
# handoff with KRULL_SESSION_OWNER_PID=$$. Keeping that ID is what lets the
# proxy find the metadata under the ID it reads from the session file.
# Anything else gets a fresh ID. That includes a krull-claude started
# from inside another session's shell: it inherits that session's ID
# and owner PID, and the owner PID is not its own. So nested and
# concurrent runs never share an ID.
if [ -z "${KRULL_SESSION_ID:-}" ] || [ "${KRULL_SESSION_OWNER_PID:-}" != "$$" ]; then
  KRULL_SESSION_ID="$(date +%Y%m%dT%H%M%S)-$$"
  unset KRULL_SESSION_META   # an inherited one names another session's file
fi
export KRULL_SESSION_ID
export KRULL_SESSION_OWNER_PID=$$
KRULL_SESSION_FILE="$HOME/.krull-session"
echo "$KRULL_SESSION_ID" > "$KRULL_SESSION_FILE"
echo "krull-claude session: $KRULL_SESSION_ID"
echo "  logs: tail -f logs/proxy.jsonl | grep $KRULL_SESSION_ID"

# Clean up the session file when claude exits. A trap here would never
# fire: the launch at the bottom is an `exec`, so claude replaces this
# shell and keeps its PID ($$). Keeping the exec keeps claude's exit code,
# its signals (Ctrl-C, SIGTERM from `timeout`) and the tty exactly as if it
# had been run directly. Instead a detached watcher waits for that PID to
# go away, however it ends, then removes the file only if it still holds
# this session's ID: a krull-claude started since in another terminal has
# overwritten it and keeps its own. The watcher ignores HUP/INT/TERM so a
# closed terminal or a Ctrl-C to the foreground group cannot kill it before
# claude is gone, and its stdio is /dev/null so it never holds open a pipe
# that a caller of `-p` is reading.
_krull_claude_pid=$$
(
  trap '' HUP INT TERM
  while kill -0 "$_krull_claude_pid" 2>/dev/null; do sleep 1; done
  if [ "$(cat "$KRULL_SESSION_FILE" 2>/dev/null)" = "$KRULL_SESSION_ID" ]; then
    rm -f "$KRULL_SESSION_FILE"
  fi
) </dev/null >/dev/null 2>&1 &

# Tell Claude Code the real context window size so its auto-compactor
# fires at the right threshold. Without this, Claude Code assumes 200K
# (the real claude-sonnet-4-6 window) but the backend holds only
# OLLAMA_NUM_CTX. Claude Code's compaction threshold = window - 20K - 13K,
# so a window LARGER than the backend makes CC wait to compact until the
# summarization prompt itself overflows the backend and comes back empty.
# The repo .env is the source of truth for OLLAMA_NUM_CTX (the settings
# page writes it), so read it here instead of hardcoding a value that
# drifts stale. KRULL_ENV_FILE, or KRULL_REPO/.env, lets the installed
# copy (~/.local/bin/krull-claude) find the checkout; the dev copy under
# scripts/ falls back to ../.env next to itself.
KRULL_ENV_FILE="${KRULL_ENV_FILE:-${KRULL_REPO:+$KRULL_REPO/.env}}"
if [ -z "$KRULL_ENV_FILE" ]; then
  _krull_self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  [ -f "$_krull_self_dir/../.env" ] && KRULL_ENV_FILE="$_krull_self_dir/../.env"
fi
KRULL_NUM_CTX=""
if [ -n "$KRULL_ENV_FILE" ] && [ -f "$KRULL_ENV_FILE" ]; then
  # OLLAMA_NUM_CTX is a bare integer in .env; take digits only so any stray
  # whitespace, quoting, or trailing comment cannot leak into the env value.
  KRULL_NUM_CTX="$(grep -E '^OLLAMA_NUM_CTX=' "$KRULL_ENV_FILE" | tail -1 | grep -oE '[0-9]+' | head -1)"
fi
#
# Local-LLM tuning (each verified against the Claude Code source):
#   ANTHROPIC_MODEL — pin the main-loop model to a name litellm/config.yaml
#     maps. Without it, whatever the installed CLI's default model is gets
#     requested verbatim, and a CLI update can silently drift past the
#     mappings.
#   ANTHROPIC_SMALL_FAST_MODEL — every background call (session titles,
#     WebFetch summarization, tool-use summaries, ...) hard-codes the
#     "small fast model", default claude-haiku-4-5. There is NO switch to
#     disable those calls; the only control is pointing them at a mapped
#     name so they hit the local backend instead of failing.
#   MAX_THINKING_TOKENS=0 — extended thinking defaults ON for first-party
#     providers (a custom base URL does not change the provider). A
#     thinking budget is wasted latency on the local backend, which does
#     its own thinking server-side.
#   DISABLE_PROMPT_CACHING=1 — stop emitting cache_control blocks the
#     local backend ignores; smaller, simpler request bodies.
#   DISABLE_COST_WARNINGS=1 — cost accounting is meaningless against a
#     local backend.
# All overridable from the environment.
ANTHROPIC_AUTH_TOKEN=sk-local-dev-key \
ANTHROPIC_BASE_URL=http://localhost:4000 \
ANTHROPIC_MODEL=${ANTHROPIC_MODEL:-claude-sonnet-4-6} \
ANTHROPIC_SMALL_FAST_MODEL=${ANTHROPIC_SMALL_FAST_MODEL:-claude-haiku-4-5-20251001} \
CLAUDE_CODE_AUTO_COMPACT_WINDOW=${CLAUDE_CODE_AUTO_COMPACT_WINDOW:-${KRULL_NUM_CTX:-65536}} \
MAX_THINKING_TOKENS=${MAX_THINKING_TOKENS:-0} \
DISABLE_PROMPT_CACHING=${DISABLE_PROMPT_CACHING:-1} \
DISABLE_COST_WARNINGS=${DISABLE_COST_WARNINGS:-1} \
DISABLE_TELEMETRY=1 \
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
exec claude "${EXTRA[@]}" "$@"
